# ==========================================================================
# plumcodesbybit - configuracao de ambiente
# Copia para `.env` e preenche. O `.env` esta no .gitignore (nunca comitar).
# ==========================================================================

# --- Cerebro dos agents (LLM) --------------------------------------------
# Provider por omissao: anthropic | nvidia. Pode ser sobreposto por agent
# no config/agents.yaml (campos `provider:` e `model:`).
PLUMBYBIT_LLM_PROVIDER=anthropic

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
PLUMBYBIT_LLM_MODEL=claude-sonnet-5

# NVIDIA API (https://build.nvidia.com -> API key). Endpoint compativel com OpenAI.
NVIDIA_API_KEY=nvapi-...
PLUMBYBIT_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
PLUMBYBIT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Bybit: conta DEMO (Demo Trading) ------------------------------------
# Cria as chaves em: Bybit > Demo Trading > API. Sao chaves da subconta demo.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# --- Bybit: conta REAL (subconta dedicada aos bots) ---------------------
# Usa uma SUBCONTA dedicada, nunca a conta principal.
# Permissoes minimas: "Contract - Orders & Positions". SEM permissao de saque.
# Recomendado: restringir por IP.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=

# --- Seguranca / kill switches -----------------------------------------
# Tem de ser exatamente "true" para permitir ordens reais. Qualquer outra
# coisa mantem tudo em modo simulado (paper), mesmo com chaves reais definidas.
PLUMBYBIT_ALLOW_REAL=false

# Se "true", nenhuma ordem e enviada a corretora - apenas regista a decisao.
# Vale para DEMO e REAL. Bom para o primeiro arranque.
PLUMBYBIT_DRY_RUN=true

# Perda maxima diaria agregada (em USDT). Ao ultrapassar, todos os agents
# param de abrir posicoes ate a meia-noite UTC.
PLUMBYBIT_MAX_DAILY_LOSS_USDT=50

# Caminho do ficheiro de configuracao dos agents.
PLUMBYBIT_AGENTS_CONFIG=config/agents.yaml

# Nivel de log: DEBUG | INFO | WARNING | ERROR
PLUMBYBIT_LOG_LEVEL=INFO
